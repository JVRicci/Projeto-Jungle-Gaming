{
  "name": "projeto-jungle-gaming",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "infra:up": "docker compose up -d postgres localstack",
    "migration:up": "bun run src/database/migrate.ts up",
    "migration:down": "bun run src/database/migrate.ts down"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.10",
    "@types/bun": "latest",
    "@types/node": "^26.6.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1173.0",
    "@mikro-orm/core": "^7.2.10",
    "@mikro-orm/decorators": "^7.2.10",
    "@mikro-orm/migrations": "^7.2.10",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.10",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
